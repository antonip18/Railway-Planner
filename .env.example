# Docker Compose reads .env. This password is for a local-only development database.
POSTGRES_PASSWORD=railway
# SECRET_KEY=set-a-long-random-value-for-deployment
# COOKIE_SECURE=1

# The Python app reads shell environment variables, not this file automatically.
# export DATABASE_URL=postgresql+psycopg://railway:railway@localhost:5432/railway
# Otherwise it uses SQLite in instance/railway.db.
# Set an admin password using: flask --app railway set-admin-password
